# Copy this file to .env (git-ignored) and fill in the values after "=". Quotes are optional.
# An empty value falls back to appsettings.json. Real environment variables override .env.

# ── Anthropic (required) ─────────────────────────────────────────────────────
Anthropic__ApiKey=

# ── Microsoft Foundry (optional second model) ────────────────────────────────
# Endpoint format: https://<resource>.openai.azure.com/openai/v1/
AzureAI__Foundry__Endpoint=
AzureAI__Foundry__ApiKey=
AzureAI__Foundry__Model=

# ── Optional Azure services ──────────────────────────────────────────────────
# Content Safety endpoint format: https://<resource>.cognitiveservices.azure.com/
AzureAI__ContentSafety__Endpoint=
AzureAI__ContentSafety__ApiKey=
APPLICATIONINSIGHTS_CONNECTION_STRING=
